{
  "name": "pi-assumptions",
  "version": "0.1.0",
  "description": "A pi extension where the agent flags its assumptions instead of stopping to ask, and you review them with /assumptions",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent"
  ],
  "author": "Sana Monhaseri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sana8200/pi-assumptions.git"
  },
  "pi": {
    "extensions": [
      "./assumptions.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "typescript": "^7.0.2"
  }
}
